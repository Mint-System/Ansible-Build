#!/usr/bin/env bash
set -e

script=$(basename "$0")
version="1.1.0"

help() {
    echo
    echo "$script"
    echo
    echo 'Description: Clone a git repo into an Odoo addons directory.'
    echo "Syntax: $script [-p|-r|-b|-t|-k|-V|help]"
    echo 'Example: $script -p /usr/share/odoo01/addons -r https://github.com/OCA/partner-contact.git -b 19.0 -t oca-partner-contact'
    echo 'Example: $script -p /usr/share/odoo01/addons -r ssh://git@github.com/Mint-System/Odoo-Apps-Swift-Link.git -b 19.0 -t mint-system-swift-link -k ~/.ssh/odoo-apps-swift-link'
    echo 'options:'
    echo '  -p    Odoo addons path. Defaults to '\''/usr/share/odoo/addons'\''.'
    echo '  -r    Git repo url. Supports https://, ssh:// and scp-like git@host:path.'
    echo '  -b    Git branch.'
    echo '  -t    Target path relative to the addons path.'
    echo '  -k    Ssh private key used for ssh remotes.'
    echo '  -V    Show $script version.'
    echo "  help  Show $script manual."
    echo
}

if [[ "$1" == 'help' ]]; then
    help
    exit
fi

path=/usr/share/odoo/addons

while getopts ':p:r:b:t:k:V' opt; do
    case $opt in
        p) path="$OPTARG";;
        r) repo="$OPTARG";;
        b) branch="$OPTARG";;
        t) target="$OPTARG";;
        k) key="$OPTARG";;
        V) echo "$script version $version"
        exit 0
        ;;
        \?) echo "Invalid option -$OPTARG" >&2
        help
        exit 1;;
    esac
done

[[ -z "$repo" ]] && { echo 'Parameter -r|repo is empty.'; exit 1; }
[[ -z "$branch" ]] && { echo 'Parameter -b|branch is empty.'; exit 1; }
[[ -z "$target" ]] && { echo 'Parameter -t|target is empty.'; exit 1; }
[[ -d "$path" ]] || { echo "Path $path does not exist."; exit 1; }

# Detect ssh remotes: ssh:// or scp-like git@host:path
is_ssh_repo=false
if [[ "$repo" =~ ^ssh:// || "$repo" =~ ^[^/]+@[^:]+: ]]; then
    is_ssh_repo=true
fi

if [[ -n "$key" ]]; then
    [[ -f "$key" ]] || { echo "Ssh key $key does not exist."; exit 1; }
    key=$(realpath "$key")
    ssh_command="ssh -i '$key' -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
fi

path="${path%/}"
repo_path="$path/$target"

[[ -e "$repo_path" ]] && { echo "Path $repo_path already exists."; exit 1; }

echo "Clone $repo branch $branch into $repo_path ..."

mkdir -p "$(dirname "$repo_path")"

if [[ "$is_ssh_repo" == true ]]; then
    if [[ -n "$key" ]]; then
        GIT_SSH_COMMAND="$ssh_command" git clone --branch "$branch" "$repo" "$repo_path"
        # Persist the key so later pulls by the same user work without extra setup
        git -C "$repo_path" config core.sshCommand "$ssh_command"
    else
        echo 'Warning: ssh remote without -k|key, using default ssh identity.'
        git clone --branch "$branch" "$repo" "$repo_path"
    fi
else
    git clone --branch "$branch" "$repo" "$repo_path"
fi

# Apply group of the addons path
path_gid=$(stat -c '%g' "$path")
if [[ "$(stat -c '%g' "$repo_path")" == "$path_gid" ]]; then
    :
elif ! chgrp -R "$path_gid" "$repo_path"; then
    echo "Cannot change group of $repo_path to $path_gid, skipping group change."
fi

echo "The repo has been cloned to $repo_path."
